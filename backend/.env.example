POSTGRES_DB=openfatoai
POSTGRES_USER=openfatoai_user
POSTGRES_PASSWORD=change_me
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__DefaultConnection=Host=postgres;Database=openfatoai;Username=openfatoai_user;Password=change_me
# Allowed origins for browser/Electron clients. Production desktop app: file://
CorsSettings__Origins=file://
# Shared key that enables PUT /api/settings/{key} (sent in the X-Api-Key header).
# Leave empty to keep settings updates disabled.
Security__ApiKey=
