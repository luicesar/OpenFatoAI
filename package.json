{
  "name": "openfatoai",
  "version": "0.1.1",
  "description": "OpenFatoAI - Intelligence for your meetings, local transcription and AI summaries with total privacy",
  "homepage": "https://github.com/luicesar/OpenFatoAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luicesar/OpenFatoAI.git"
  },
  "bugs": {
    "url": "https://github.com/luicesar/OpenFatoAI/issues"
  },
  "main": "src/main/index.js",
  "scripts": {
    "css": "tailwindcss -i ./src/renderer/styles/main.css -o ./src/renderer/styles/output.css",
    "css:watch": "tailwindcss -i ./src/renderer/styles/main.css -o ./src/renderer/styles/output.css --watch",
    "start": "npm run css && ELECTRON_OZONE_PLATFORM_HINT=x11 electron .",
    "dev": "ELECTRON_OZONE_PLATFORM_HINT=x11 concurrently \"npm run css:watch\" \"electron .\"",
    "download-model": "bash ./scripts/download-vosk-model.sh",
    "build:css": "tailwindcss -i ./src/renderer/styles/main.css -o ./src/renderer/styles/output.css",
    "dist": "npm run build:css && electron-builder",
    "dist:dir": "npm run build:css && electron-builder --dir",
    "dist:x64": "npm run build:css && electron-builder --linux --x64",
    "dist:arm64": "npm run build:css && electron-builder --linux --arm64",
    "dist:win": "npm run build:css && electron-builder --win --x64",
    "dist:mac": "npm run build:css && electron-builder --mac --x64 --arm64",
    "release": "bash ./scripts/release.sh"
  },
  "author": "OpenFatoAI Contributors",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.3",
    "screenshot-desktop": "^1.13.0",
    "sql.js": "^1.14.1",
    "vosk-browser": "^0.0.8"
  }
}
