# Copie para docker/.env e ajuste. Nunca versione o .env.

# ── Banco ────────────────────────────────────────────────────────
POSTGRES_DB=openfatoai
POSTGRES_USER=openfatoai_user
# Obrigatória. Evite ';' e espaços (a senha vai dentro de uma connection string).
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# ── API ──────────────────────────────────────────────────────────
API_PORT=5000
# 127.0.0.1 = só esta máquina. Use o IP da sua rede privada para expor na LAN.
API_BIND=127.0.0.1
# Origens aceitas (app desktop = file://). Separe várias por vírgula.
CORS_ORIGINS=file://
# Chave que habilita PUT /api/settings/{key} (header X-Api-Key). Vazio = desabilitado.
SECURITY_API_KEY=

# ── HTTPS opcional (docker compose --profile https up -d) ────────
DOMAIN=
